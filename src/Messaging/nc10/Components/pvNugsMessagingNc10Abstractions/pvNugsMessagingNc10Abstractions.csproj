<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Version>10.1.0</Version>

        <Authors>Pierre Van Wallendael</Authors>
        <Copyright>pvWay Ltd</Copyright>

        <PackageReleaseNotes>
            Updated the raw string consumer callback contract to provide the source topic,
            publication metadata, and message payload as separate parameters.
            This aligns the raw string consumer with the typed consumer contract and provides
            consistent handler semantics across both consumer models.
            Updated the documentation and usage examples accordingly.
        </PackageReleaseNotes>
        
        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageIcon>pvwayLogoTextLess256.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <RepositoryType>GitHub</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <RepositoryUrl>https://github.com/licheez/pvWayNugs.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/licheez/pvWayNugs.git</PackageProjectUrl>

        <PackageTags>messaging, kafka, mq, rabbitmq, azure-service-bus, redis, pubsub, message-broker, monitoring, abstraction, .net, dependency-injection, pvway, pvwaynugs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="readme.md"
              Pack="true"
              PackagePath="\" />

        <None Update="bin/$(Configuration)\$(TargetFramework)\$(AssemblyName).xml">
            <Pack>true</Pack>
            <PackagePath>lib\$(TargetFramework)</PackagePath>
        </None>

        <None Update="pvwayLogoTextLess256.png">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>