<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Version>10.0.1</Version>

        <Authors>Pierre Van Wallendael</Authors>
        <Copyright>pvWay Ltd</Copyright>

        <PackageReleaseNotes>
            Added optional consumer group support to messaging subscriptions.
            Added broker-neutral messaging monitoring contracts for topic status,
            pending messages, active consumers, and last activity.
            Added metric availability statuses to represent provider capabilities
            without exposing broker-specific monitoring contracts.
        </PackageReleaseNotes>

        <PackageReadmeFile>readme.md</PackageReadmeFile>
        <PackageIcon>pvwayLogoTextLess256.png</PackageIcon>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <RepositoryType>GitHub</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <RepositoryUrl>https://github.com/licheez/pvWayNugs.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/licheez/pvWayNugs.git</PackageProjectUrl>

        <PackageTags>messaging, kafka, mq, rabbitmq, azure-service-bus, redis, pubsub, message-broker, monitoring, abstraction, .net, dependency-injection, pvway, pvwaynugs</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="readme.md"
              Pack="true"
              PackagePath="\" />

        <None Update="bin/$(Configuration)\$(TargetFramework)\$(AssemblyName).xml">
            <Pack>true</Pack>
            <PackagePath>lib\$(TargetFramework)</PackagePath>
        </None>

        <None Update="pvwayLogoTextLess256.png">
            <Pack>true</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>